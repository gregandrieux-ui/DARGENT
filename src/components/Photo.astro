---
// Photo avec sa légende. Sans src : slot « à collecter ».
// Les visuels de /images/illustrations/ sont des dessins (pas des chantiers) : libellé « Illustration » imposé.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import images from '../data/images.json';
// Mêmes fichiers que public/ (URLs publiques conservées : redirections, JSON-LD, liens d'agrandissement) ; Astro en tire des AVIF/WebP.
const rasters = import.meta.glob<ImageMetadata>('../../public/images/**/*.{jpg,jpeg,png}', { eager: true, import: 'default' });
const asset = (src: string) => rasters[`../../public${src}`];
import { showTodo } from '../data/site';
interface Props { src?: string; alt?: string; caption?: string; label?: string; missing?: string; priority?: boolean; class?: string; sizes?: string }
const { src, alt = '', caption, label = 'Observations', missing, priority = false, class: cls = '', sizes = '(min-width: 1600px) 760px, (min-width: 768px) 50vw, 100vw' } = Astro.props;
const meta = src ? asset(src) : undefined;
const illustration = src?.startsWith('/images/illustrations/') ?? false;
const dim = illustration ? { w: 800, h: 600 } : src ? (images as Record<string, { w: number; h: number }>)[src] : undefined;
---
<figure class={`photo ${illustration ? 'photo-illustration' : ''} ${cls}`}>
  {meta ? (
    <Picture src={meta} alt={alt} formats={['avif', 'webp']} widths={[400, 800, 1200].filter((w) => w < meta.width).concat(meta.width)} sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding={priority ? 'sync' : 'async'} />
  ) : src ? (
    <img src={src} alt={alt} width={dim?.w} height={dim?.h} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding={priority ? 'sync' : 'async'} />
  ) : showTodo ? (
    <div class="photo-missing"><Icon name="photo" /><span>Photo de chantier à collecter{missing ? ` : ${missing}` : ''}</span></div>
  ) : null}
  {caption && (src || showTodo) && <figcaption><span class="lbl">{illustration ? 'Illustration' : label}</span><span>{caption}</span></figcaption>}
</figure>
