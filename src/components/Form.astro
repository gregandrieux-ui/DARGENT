---
// Formulaires Netlify (devis, contact, candidature). Labels visibles, erreurs natives, honeypot, RGPD.
interface Props { kind: 'devis' | 'contact' | 'candidature'; submit: string }
const { kind, submit } = Astro.props;
---
<form class="form" name={kind} method="POST" action="/merci/" data-astro-reload data-netlify="true" netlify-honeypot="site-web" enctype={kind === 'candidature' ? 'multipart/form-data' : undefined}>
  <input type="hidden" name="form-name" value={kind} />
  <p class="hp"><label>Ne pas remplir <input name="site-web" tabindex="-1" autocomplete="off" /></label></p>
  {kind === 'devis' && (
    <>
      <div><label for="projet">Votre projet</label>
        <select id="projet" name="projet" required>
          <option value="">Choisir</option>
          <option>Pompe à chaleur</option><option>Climatisation</option><option>Chaudière ou chauffage</option><option>Ventilation</option><option>Entretien ou contrat</option><option>Dépannage</option>
        </select></div>
      <div><label for="logement">Type de logement</label>
        <select id="logement" name="logement" required>
          <option value="">Choisir</option>
          <option>Maison</option><option>Appartement</option><option>Local professionnel</option><option>Copropriété ou collectivité</option>
        </select></div>
      <div><label for="commune">Commune du logement</label><input id="commune" name="commune" required autocomplete="address-level2" placeholder="Orléans" /></div>
    </>
  )}
  {kind === 'candidature' && (
    <>
      <div><label for="poste">Poste souhaité</label><input id="poste" name="poste" required placeholder="Technicien de maintenance" /></div>
      <div><label for="cv">CV <span class="hint">(PDF, 5 Mo max)</span></label><input id="cv" name="cv" type="file" accept=".pdf" required /></div>
    </>
  )}
  <div><label for="nom">Nom et prénom</label><input id="nom" name="nom" required autocomplete="name" /></div>
  <div><label for="tel">Téléphone</label><input id="tel" name="telephone" type="tel" required autocomplete="tel" placeholder="06 12 34 56 78" /></div>
  <div><label for="email">E-mail</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="nom@exemple.fr" /></div>
  <div><label for="message">{kind === 'devis' ? 'Votre projet en quelques mots' : kind === 'candidature' ? 'Quelques mots sur vous' : 'Votre message'} <span class="hint">(facultatif)</span></label><textarea id="message" name="message" placeholder={kind === 'devis' ? 'Remplacement d’une chaudière gaz, maison de 120 m², radiateurs existants.' : ''}></textarea></div>
  <div class="rgpd"><label style="font-weight:400"><input type="checkbox" name="rgpd" required value="oui" />J’accepte que Dargent Thermique utilise ces informations pour répondre à ma demande. Elles ne sont jamais transmises à des tiers. <a href="/protection-donnees/">Comment vos données sont traitées</a></label></div>
  <div><button type="submit" class="btn">{submit}</button></div>
</form>
