---
// Liens de sortie en fin de fiche (colonne « Liens sortants » du xlsx, ancres descriptives).
interface Props { links: { href: string; label: string }[]; title?: string }
const { links, title = 'Pour continuer' } = Astro.props;
---
{links.length > 0 && (
  <nav aria-label={title}>
    <h2>{title}</h2>
    <ol class="exits">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ol>
  </nav>
)}
