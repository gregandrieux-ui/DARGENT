---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { title?: string }
const { title = 'Avis clients' } = Astro.props;
---
<section class="section" aria-labelledby="avis-title">
  <div class="container">
    <h2 id="avis-title">{title}</h2>
    <ul class="revs">
      {site.reviews.map((r) => (
        <li><blockquote>« {r.text} »</blockquote><p class="who"><span class="av" aria-hidden="true">{r.name[0]}</span><span>{r.name}<small>Avis Google</small></span></p></li>
      ))}
    </ul>
    <p class="revs-more"><a href={site.googleReviewUrl} rel="noopener">Voir tous les avis Google <Icon name="arrow-up-right" /></a></p>
  </div>
</section>
