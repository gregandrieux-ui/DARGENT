---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ToConfirm from '../components/ToConfirm.astro';
import CtaBand from '../components/CtaBand.astro';
import Exploded from '../components/Exploded.astro';
import { site } from '../data/site';
import { byCat } from '../data/realisations';
import { breadcrumb } from '../lib/schema';
import { getCollection } from 'astro:content';

const title = 'Chauffage, climatisation et PAC à Orléans | Dargent';
const description = 'Installateur RGE de pompes à chaleur, climatisation et chauffage à Orléans depuis 1936. Étude personnalisée et devis gratuit. Appelez le 02 38 86 46 46.';
const zones = (await getCollection('pages', (p) => p.id.startsWith('zones-intervention/') && !p.data.draft)).sort((a, b) => a.data.h1.localeCompare(b.data.h1));
const hero = byCat('maintenance').find((x) => x.n === '033')!;
// Court métrage : 6 cases du storyboard dépanneur, enchaînées en CSS (3 s chacune).
const frames = Object.values(import.meta.glob<ImageMetadata>('../assets/film/*.jpg', { eager: true, import: 'default' }));
const install = [
  { href: '/pompe-a-chaleur/', label: 'Pompe à chaleur', hot: true },
  { href: '/climatisation/', label: 'Climatisation' },
  { href: '/chauffage/', label: 'Chauffage' },
  { href: '/ventilation/', label: 'Ventilation' },
];
const maintain = [
  { href: '/pompe-a-chaleur/entretien/', label: 'Pompe à chaleur' },
  { href: '/climatisation/entretien/', label: 'Climatisation' },
  { href: '/chauffage/entretien-chaudiere/', label: 'Chaudière' },
];
const proofs = [
  { icon: 'calendar', value: '1936', label: 'trois générations de chauffagistes' },
  { icon: 'file-certificate', value: 'RGE', label: 'Qualibat, QUALIPAC' },
  { icon: 'tool', value: '1993', label: 'bureau d’études interne' },
  { icon: 'droplet', value: '111363-R1', label: 'habilités fluides frigorigènes' },
];
const steps = [
  { title: 'Visite technique', text: 'Un technicien vient voir votre logement, vos émetteurs et l’emplacement des équipements.' },
  { title: 'Étude', text: 'Notre bureau d’études dimensionne l’installation selon votre isolation et vos usages.' },
  { title: 'Devis', text: 'Il arrive après la visite : gratuit et sans engagement.' },
];
---
<Base title={title} description={description} path="/" schema={[breadcrumb([{ name: 'Accueil', path: '/' }])]} ogImage={hero.src}>
  <div class="home-c">
    <section class="hero hero-x hero-home" aria-labelledby="home-title"><div class="hero-x-pin"><div class="container entry">
      <div>
        <p class="eyebrow">RGE Qualibat · chauffagistes depuis 1936</p>
        <h1 id="home-title">Chauffage, climatisation et pompe à chaleur à Orléans</h1>
        <p class="promise">Une visite technique et une étude par notre bureau d’études avant tout devis.</p>
        <div class="actions">
          <a class="btn" href="/devis/">Demander un devis</a>
          <a class="tel" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>
        </div>
      </div>
      <Exploded unit="random" />
    </div></div></section>

    <section class="intro"><div class="container">
      <p class="intro-top">Choisissez votre situation, on vous emmène directement au bon endroit.</p>

      <div class="tiles">
        <div class="tile tile-install">
          <p class="q">J’ai un projet</p>
          <h2>Installer un nouvel équipement</h2>
          <p>Visite technique et étude par notre bureau d’études avant tout devis.</p>
          <ul class="chips">{install.map((l) => <li><a href={l.href} class={l.hot ? 'hot' : ''}>{l.label}</a></li>)}</ul>
        </div>
        <div class="tile tile-maintain">
          <p class="q">J’ai déjà un équipement</p>
          <h2>L’entretenir</h2>
          <p>Forfait ou contrat, avec rapport d’intervention et attestation remis.</p>
          <ul class="chips">{maintain.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div class="tile tile-alert">
          <p class="q">C’est urgent</p>
          <h2>Mon appareil est en panne</h2>
          <p>Diagnostic, puis devis avant toute réparation.</p>
          <a class="num" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>
          <a class="small" href="/depannage/">Nos engagements de dépannage</a>
        </div>
      </div>

      <ul class="proofs facts-hidden">
        {proofs.map((p) => <li><span class="dot"><Icon name={p.icon} /></span><span><strong>{p.value}</strong>{p.label}</span></li>)}
      </ul>
    </div></section>

    <section class="section"><div class="container how">
      <div>
        <h2>Pas de prix au téléphone. Une visite d’abord.</h2>
        <ol class="nums">
          {steps.map((s, i) => <li><span class="k">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>)}
        </ol>
      </div>
      <figure class="film" role="img" aria-label="Court dessin animé : Sarah grelotte chez elle, appelle Dargent, le dépanneur arrive aussitôt et relance la chaudière.">
        {frames.map((f, i) => <Image src={f} alt="" class={`f f${i + 1}`} style={`--i:${i}`} />)}
      </figure>
    </div></section>

    <section class="section" aria-labelledby="zone-title"><div class="container">
      <h2 id="zone-title">Zone d’intervention</h2>
      <p class="zones"><Icon name="map-pin" /> Depuis notre siège de Saint-Jean-de-Braye, nous intervenons à Orléans et dans toute l’agglomération, en installation comme en dépannage.</p>
      <ul class="chips">
        {zones.map((z) => <li><a href={`/${z.id}/`}>{z.data.h1}</a></li>)}
        <li><a href="/zones-intervention/" class="hot">Toutes les zones</a></li>
      </ul>
    </div></section>

    <CtaBand>
      <ToConfirm items={['Effectif actuel', 'Horaires d’ouverture', 'Nom du groupe propriétaire depuis 2018', 'Zone réellement couverte en installation et en dépannage', 'Validité des certificats Qualibat']} />
    </CtaBand>
  </div>

  <style>
    /* Direction C : motifs partagés dans global.css ; ici, seulement la mise en page propre à l'accueil. */
    /* Hero bleu nuit dans le prolongement de la nav ; coins bas arrondis. */
    .hero-home { background: var(--brand-900); color: var(--blue-200); border-radius: 0 0 var(--round) var(--round); --focus: var(--cyan); }
    .hero-home h1 { color: #fff; }
    .hero-home .promise { color: var(--blue-200); }
    .hero-home .tel { color: #fff; }
    .hero-home .eyebrow { background: rgba(255, 255, 255, 0.1); color: var(--cyan-200); }
    .intro { padding: var(--s-7) 0 var(--s-6); }
    .intro-top { color: var(--ink-600); font-weight: 600; margin: 0 0 var(--s-5); }
    .home-c > :global(.section + .section) { padding-top: 0; }
    .zones { color: var(--ink-600); margin: var(--s-5) 0; max-width: none; }
    .zones :global(.icon) { color: var(--cyan-700); vertical-align: -0.15em; }

    .film { position: relative; margin: 0; aspect-ratio: 3 / 2; border-radius: var(--round); overflow: hidden; }
    .f { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: frame 18s linear infinite; animation-delay: calc(var(--i) * 3s); }
    @keyframes frame {
      0% { opacity: 0; transform: scale(1); }
      2.5%, 16.7% { opacity: 1; }
      20%, 100% { opacity: 0; transform: scale(1.08); }
    }
    /* Effets par case : BRRR, paf, zap, travail éclair, détente. */
    .f1 { animation-name: frame, shiver; }
    .f3, .f4 { animation-name: frame, flash; }
    .f5 { animation-name: frame, rush; }
    @keyframes shiver {
      0%, 16%, 100% { translate: 0; }
      1%, 3%, 5%, 7%, 9%, 11%, 13%, 15% { translate: -2px 0; }
      2%, 4%, 6%, 8%, 10%, 12%, 14% { translate: 2px 0; }
    }
    @keyframes flash {
      0%, 1% { filter: brightness(1); }
      3% { filter: brightness(1.9); }
      6%, 100% { filter: brightness(1); }
    }
    @keyframes rush {
      0%, 3%, 17%, 100% { rotate: 0deg; }
      5%, 9%, 13% { rotate: -0.6deg; }
      7%, 11%, 15% { rotate: 0.6deg; }
    }
    @media (prefers-reduced-motion: reduce) {
      .f { animation: none; }
      .f6 { opacity: 1; }
    }
  </style>
</Base>
