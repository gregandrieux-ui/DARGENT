---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import ToConfirm from '../../components/ToConfirm.astro';
import Exits from '../../components/Exits.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories, photos } from '../../data/realisations';
import { breadcrumb, webPage } from '../../lib/schema';
const path = '/realisations/';
const title = 'Nos réalisations : PAC, climatisation, chauffage à Orléans';
const description = 'Photos de chantiers réalisés par Dargent Thermique autour d’Orléans : climatisation, chaudières à condensation, planchers chauffants, ventilation, maintenance.';
const gallery = { '@type': 'ImageGallery', name: 'Réalisations Dargent Thermique', url: 'https://dargent-thermique.fr/realisations/', image: photos.map((x) => `https://dargent-thermique.fr${x.src}`) };
---
<Base title={title} description={description} path={path} schema={[breadcrumb([{ name: 'Accueil', path: '/' }, { name: 'Nos réalisations', path }]), webPage('CollectionPage', 'Nos réalisations', description, path), gallery]} ogImage={photos[0].src}>
  <section class="hero"><div class="container">
    <nav class="breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li><span aria-current="page">Nos réalisations</span></li></ol></nav>
    <h1>Nos réalisations dans l’agglomération orléanaise</h1>
    <p class="promise">Trente chantiers photographiés par nos équipes, classés par type d’installation. Aucune photo de catalogue.</p>
    <ToConfirm items={['Légendes à enrichir : bâtiment, commune, année', 'Accord écrit des clients cités (Gémo Gien)', 'Photos de PAC air/eau et de climatisation gainable à collecter']} />
  </div></section>
  <section class="section" style="padding-top:0"><div class="container">
    <div class="filters" role="group" aria-label="Filtrer par type d’installation">
      <label><input type="radio" name="cat" value="all" checked /> Tout voir</label>
      {categories.map((c) => <label><input type="radio" name="cat" value={c.id} /> {c.label}</label>)}
    </div>
    <ul class="gallery" id="galerie">
      {photos.map((x) => (
        <li data-cat={x.cat}><a href={x.src} aria-label={`Agrandir : ${x.caption}`}><Photo src={x.thumb} alt={x.caption} caption={x.caption} label={categories.find((c) => c.id === x.cat)?.label} /></a></li>
      ))}
    </ul>
    <h2>Une réalisation par page de service</h2>
    <dl class="ruled ruled-wide">
      {categories.map((c) => <><dt>{c.label}</dt><dd><a href={c.page}>Voir la prestation</a></dd></>)}
    </dl>
    <Exits links={[{ href: '/pompe-a-chaleur/', label: 'Pompe à chaleur à Orléans' }, { href: '/climatisation/', label: 'Climatisation à Orléans' }, { href: '/zones-intervention/', label: 'Nos zones d’intervention' }, { href: '/devis/', label: 'Demander un devis' }]} />
  </div></section>
  <CtaBand />
  <style>
    .filters + .gallery li { display: block; }
    {categories.map((c) => `.filters:has(input[value="${c.id}"]:checked) + .gallery li:not([data-cat="${c.id}"]) { display: none; }`).join('\n')}
    .gallery a { color: inherit; text-decoration: none; }
    .gallery a:hover figcaption { color: var(--navy); }
  </style>
</Base>
