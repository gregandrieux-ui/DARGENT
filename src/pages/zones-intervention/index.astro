---
import Base from '../../layouts/Base.astro';
import Cachet from '../../components/Cachet.astro';
import ToConfirm from '../../components/ToConfirm.astro';
import Exits from '../../components/Exits.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { breadcrumb, webPage } from '../../lib/schema';
const path = '/zones-intervention/';
const title = 'Zones d’intervention : Orléans et son agglomération';
const description = 'Dargent Thermique intervient depuis Saint-Jean-de-Braye sur Orléans et l’agglomération orléanaise : pompe à chaleur, climatisation, chauffage, entretien.';
// Seules les communes disposant d'une page réellement publiée sont listées (règle Maillage).
const locals = (await getCollection('pages', (p) => p.id.startsWith('zones-intervention/') && !p.data.draft)).sort((a, b) => a.data.h1.localeCompare(b.data.h1));
---
<Base title={title} description={description} path={path} schema={[breadcrumb([{ name: 'Accueil', path: '/' }, { name: 'Zones d’intervention', path }]), webPage('CollectionPage', 'Zones d’intervention', description, path)]}>
  <section class="hero"><div class="container">
    <nav class="breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li><span aria-current="page">Zones d’intervention</span></li></ol></nav>
    <div class="entry">
      <div>
        <h1>Nos zones d’intervention</h1>
        <p class="promise">Installés à Saint-Jean-de-Braye depuis 1969, nous intervenons sur Orléans et toute l’agglomération, en installation comme en dépannage.</p>
        <h2 style="font-size: var(--text-h3)">Communes avec une page dédiée</h2>
        <dl class="ruled">
          {locals.map((l) => <><dt>{l.data.h1.includes('Saint-Jean-de-Braye') ? 'Siège' : 'Commune'}</dt><dd><a href={`/${l.id}/`}>{l.data.h1}</a></dd></>)}
        </dl>
        <p>Les autres communes de l’agglomération (Olivet, Fleury-les-Aubrais, Saint-Jean-de-la-Ruelle, Saran, Saint-Jean-le-Blanc, Saint-Denis-en-Val, Chécy, Semoy…) sont couvertes ; une page détaillée est publiée dès que nous pouvons y montrer des chantiers réels.</p>
        <ToConfirm items={['Liste exacte des communes couvertes, en installation et en dépannage', 'Chantiers localisés à Orléans, Olivet, Fleury-les-Aubrais, Saint-Jean-de-la-Ruelle (pages locales en attente)']} />
      </div>
      <div><Cachet /></div>
    </div>
    <Exits links={[{ href: '/contact/', label: 'Nous contacter ou venir nous voir' }, { href: '/pompe-a-chaleur/', label: 'Pompe à chaleur à Orléans' }, { href: '/entretien/', label: 'Entretien sur l’agglomération' }, { href: '/depannage/', label: 'Dépannage sur l’agglomération' }, { href: '/devis/', label: 'Demander un devis' }]} />
  </div></section>
  <CtaBand />
</Base>
