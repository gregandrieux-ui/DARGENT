---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Checks from '../components/Checks.astro';
import Exits from '../components/Exits.astro';
import Faq from '../components/Faq.astro';
import ToConfirm from '../components/ToConfirm.astro';
import Reassurance from '../components/Reassurance.astro';
import CtaBand from '../components/CtaBand.astro';
import Cachet from '../components/Cachet.astro';
import Exploded from '../components/Exploded.astro';
import { site } from '../data/site';
import { breadcrumb, faqPage, howTo, localBusiness, service, webPage } from '../lib/schema';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
const d = page.data;
const path = `/${page.id}/`;
const { Content } = await render(page);

const crumbs = [{ name: 'Accueil', path: '/' }, ...d.crumbs.map((c) => ({ name: c.label, path: c.href })), { name: d.h1, path }];
const schema: object[] = [breadcrumb(crumbs)];
if (d.schema === 'Service') schema.push(service(d.h1, d.description, path));
else if (d.schema === 'LocalBusiness') schema.push(localBusiness(d.h1, path, d.crumbs.length ? d.h1.replace(/^.*à /, '') : 'Orléans'));
else schema.push(webPage(d.schema, d.h1, d.description, path));
if (d.faq.length) schema.push(faqPage(d.faq));
if (d.howto.length) schema.push(howTo(d.h1, d.howto));

const isService = d.template === 'service' || d.template === 'pilier';
const heroPhoto = d.photos[0];
const morePhotos = d.unit ? d.photos : d.photos.slice(1); // vue éclatée en hero : le schéma reste en galerie
const simple = d.template === 'legal';
const isLocal = d.template === 'local';
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${site.geo.lng - 0.012},${site.geo.lat - 0.007},${site.geo.lng + 0.012},${site.geo.lat + 0.007}&layer=mapnik&marker=${site.geo.lat},${site.geo.lng}`;
---
<Base title={d.title} description={d.description} path={path} noindex={d.draft} schema={schema} alert={d.alert} ogImage={heroPhoto?.src}>
  <section class:list={['hero', { 'hero-alert': d.alert, 'hero-x': d.unit }]}>
    <div class:list={{ 'hero-x-pin': d.unit }}>
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d’Ariane">
        <ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol>
      </nav>
      <div class={simple ? '' : 'entry'}>
        <div>
          <h1>{d.h1}</h1>
          {d.stats.length > 0 ? (
            <>
              <ul class="stats">{d.stats.map((s) => <li><strong>{s.value}</strong> {s.label}</li>)}</ul>
              <p class="stats-note">* Ordres de grandeur ADEME et fabricants, selon logement, usage et éligibilité. Chiffrage réel après visite technique.</p>
            </>
          ) : (
            <>
              <p class="promise">{d.promise}</p>
              {d.checks.length > 0 && <Checks items={d.checks} />}
            </>
          )}
          {!simple && (
            <div class="actions">
              {d.alert ? (
                <a class="tel-big" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>
              ) : (
                <a class="btn" href={d.cta.href}>{d.cta.label}</a>
              )}
              {d.alert ? <a class="btn btn-cyan" href={d.cta.href}>{d.cta.label}</a> : <a class="tel" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>}
            </div>
          )}
        </div>
        {!simple && (d.unit ? (
          <Exploded unit={d.unit} />
        ) : heroPhoto ? (
          <Photo src={heroPhoto.src} alt={heroPhoto.alt} caption={heroPhoto.caption} missing={heroPhoto.missing} priority class="hero-photo" />
        ) : (
          <div class="hero-photo"><Cachet /></div>
        ))}
      </div>
      {d.facts.length > 0 && <dl class={isService || d.template === 'hub' ? 'facts facts-hidden' : 'facts'}>{d.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>}
    </div>
    </div>
  </section>

  {d.needs.length > 0 && (
    <section class="section needs" aria-labelledby="needs-title">
      <div class="container">
        <h2 id="needs-title">Votre besoin, notre réponse</h2>
        <div class="tiles tiles-3">
          {d.needs.map((n, i) => (
            <div class={`tile ${['tile-install', 'tile-maintain', 'tile-dark'][i % 3]}`}>
              <p class="q">{n.q}</p>
              <h3>{n.title}</h3>
              <p>{n.text}</p>
              <a class="go" href={n.href}>Découvrir <Icon name="arrow-right" /></a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" style="padding-top: 0">
    <div class="container">
      <ToConfirm items={d.toConfirm} />
      <div class="prose">
        <Content />
      </div>
      {morePhotos.length > 0 && (
        <ul class="gallery" style="margin-top: 32px">
          {morePhotos.map((p) => <li><Photo src={p.src} alt={p.alt} caption={p.caption} missing={p.missing} /></li>)}
        </ul>
      )}
      {isLocal && (
        <>
          <h2>Nous trouver</h2>
          <div class="entry">
            <dl class="ruled">
              <dt>Adresse</dt><dd>{site.street}<br />{site.postalCode} {site.city}</dd>
              <dt>Téléphone</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd>
              <dt>Accès</dt><dd>Zone industrielle, à proximité de la tangentielle, de l’A10 et de l’A71</dd>
              <dt>Horaires</dt><dd>{site.hours}</dd>
            </dl>
            <iframe title="Plan d’accès à Dargent Thermique" src={osm} width="600" height="320" style="width:100%;border:1px solid var(--rule)" loading="lazy" referrerpolicy="no-referrer"></iframe>
          </div>
        </>
      )}
      {d.faq.length > 0 && <><h2>Questions fréquentes</h2><Faq items={d.faq} /></>}
      {d.cta2 && <p style="margin-top: 32px"><a class="btn btn-outline" href={d.cta2.href}>{d.cta2.label}</a></p>}
      <Exits links={d.links} />
    </div>
  </section>

  {isService && <Reassurance aides={d.aides} cta={d.cta} />}
  {!simple && <CtaBand alert={d.alert} cta={d.alert ? `Appeler le ${site.phone}` : d.cta.label} href={d.cta.href} title={d.alert ? 'Une panne ? Un diagnostic, puis un devis avant toute réparation.' : undefined} text={d.alert ? 'Intervention sur rendez-vous par un technicien habilité fluides frigorigènes.' : undefined} />}
</Base>

<script>
  // Cartes empilées : une carte plus haute que l'écran s'épingle par le bas (top négatif) pour rester lisible en entier.
  const cards = document.querySelectorAll<HTMLElement>('.stack-card');
  if (cards.length) {
    const pin = () => {
      const top = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) + 24;
      const bottom = innerHeight - (document.querySelector<HTMLElement>('.stickycall')?.offsetHeight ?? 0) - 16; // barre d'appel mobile
      const ends = [...cards].map((c, i) => {
        const slot = top + i * 12;
        const pin = Math.min(slot, bottom - c.offsetHeight);
        c.style.setProperty('--pin', `${pin}px`);
        c.style.setProperty('--lift', `${slot - pin}px`); // carte haute : redescend à son cran quand la suivante la recouvre
        return pin + c.offsetHeight;
      });
      // Une carte sticky se décroche quand son bas touche la fin de .stack : on aligne tous les bas épinglés,
      // sinon la plus haute remonte seule en fin de pile au lieu de partir avec les autres.
      const end = Math.max(...ends);
      cards.forEach((c, i) => (c.style.marginBottom = `${end - ends[i]}px`));
      // Carte recouverte : rognée par le bas pendant son recul (clip avant scale 0.92) pour finir 12 px au-dessus
      // du bas épinglé le plus haut des cartes suivantes, sinon son bas dépasse sous la carte active.
      let lowest = Infinity;
      for (let i = cards.length - 1; i >= 0; i--) {
        const keep = (lowest - 12 - (top + i * 12)) / 0.92;
        cards[i].style.setProperty('--clip', `${Math.max(0, cards[i].offsetHeight - keep)}px`);
        lowest = Math.min(lowest, ends[i]);
      }
    };
    pin();
    const ro = new ResizeObserver(pin);
    cards.forEach((c) => ro.observe(c));
    addEventListener('resize', pin);
    // Ancre (#id) dans une carte : le navigateur mesure la carte sticky à sa position épinglée et tombe à côté.
    // On recalcule sa position dans le flux (haut de .stack + cartes précédentes) et on l'amène à son cran.
    const toCard = (hash: string) => {
      const card = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1)))?.closest<HTMLElement>('.stack-card') : null;
      if (!card) return false;
      const stack = card.parentElement!;
      const gap = parseFloat(getComputedStyle(stack).rowGap) || 0;
      const i = [...cards].indexOf(card);
      let y = stack.getBoundingClientRect().top + scrollY;
      for (let k = 0; k < i; k++) y += cards[k].offsetHeight + parseFloat(cards[k].style.marginBottom || '0') + gap;
      const top = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) + 24;
      scrollTo({ top: y - top - i * 12, behavior: 'instant' });
      return true;
    };
    addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
      if (!a || a.pathname !== location.pathname || !toCard(a.hash)) return;
      e.preventDefault();
      history.pushState(null, '', a.hash);
    });
    addEventListener('popstate', () => toCard(location.hash));
    addEventListener('load', () => toCard(location.hash));
  }
  // Carrousel : flèches = une entrée de plus ; grisées aux extrémités.
  document.querySelectorAll<HTMLElement>('.carousel-wrap').forEach((w) => {
    const track = w.querySelector<HTMLElement>('.carousel')!;
    const [prev, next] = w.querySelectorAll<HTMLButtonElement>('.carousel-btn');
    const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
    const sync = () => {
      // Piste à la hauteur de la vignette visible : pas de vide sous les courtes.
      const cs = getComputedStyle(track);
      const chrome = track.offsetHeight - track.clientHeight + parseFloat(cs.paddingBottom); // barre de défilement + padding
      track.style.height = `${(slides[Math.round(track.scrollLeft / track.clientWidth)]?.offsetHeight ?? 0) + chrome}px`;
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft > track.scrollWidth - track.clientWidth - 4;
    };
    w.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('.carousel-btn');
      if (b) track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth, behavior: 'smooth' });
    });
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  });
</script>
