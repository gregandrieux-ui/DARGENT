---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { graph, organization, website } from '../lib/schema';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  schema?: object[];
  ogImage?: string;
  alert?: boolean;
  bodyClass?: string;
}
const { title, description, path, noindex = false, schema = [], ogImage = '/logo.png', alert = false, bodyClass = '' } = Astro.props;
const canonical = new URL(path, site.url).href;
const jsonld = JSON.stringify(graph(organization(), website(), ...schema));
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b2a4a" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={jsonld} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <nav class="stickycall" aria-label="Appeler ou demander un devis">
      <a href={site.phoneHref} class={alert ? 'alert' : ''}><Icon name="phone" /> Appeler</a>
      <a href="/devis/" class="primary">Demander un devis</a>
    </nav>
    <Consent />
  </body>
</html>
